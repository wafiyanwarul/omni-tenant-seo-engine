// prisma/schema.prisma

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id Int @id @default(autoincrement())

  // --- Core Identity ---
  name        String
  slug        String  @unique
  description String
  logoUrl     String?

  // --- Location ---
  province String
  city     String
  address  String?

  // --- Contact & Web ---
  website      String?
  email        String?
  phone        String?
  linkedinUrl  String?
  instagramUrl String?

  // --- Business Profile ---
  services      Json
  foundedYear   Int?
  employeeCount String?
  pricingModel  String?

  // --- Directory Metadata ---
  isVerified     Boolean   @default(false)
  sourceName     String?
  sourceUrl      String?
  lastReviewedAt DateTime?

  // --- Timestamps ---
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // --- Indexes for SEO query performance ---
  @@index([city])
  @@index([slug])
  @@index([province])
  @@index([isVerified])
}
